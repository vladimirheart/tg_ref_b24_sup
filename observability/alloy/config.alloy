loki.source.file "iguana_files" {
  targets = [
    {
      "__path__"         = "/var/log/iguana/**/*.log",
      "__path_exclude__" = "/var/log/iguana/**/*.{gz,zip,bak,old}",
      "job"              = "iguana-files",
      "stack"            = "iguana",
    },
  ]
  forward_to = [loki.write.local.receiver]

  file_match {
    enabled     = true
    sync_period = "10s"
  }
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
