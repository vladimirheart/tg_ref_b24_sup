# .gitignore
.env
__pycache__/
panel/node_modules/
node_modules/
.idea/
.vscode/
object_passport_uploads/
attachments/
/logs/
/spring-panel/logs/
/java-bot/target/
/java-bot/**/target/
/java-bot/**/logs/
/java-bot/.m2/
/spring-panel/.m2/
/spring-panel/target/
/config/shared/monitoring-credentials.key
/config/shared/backup.properties
/config/shared/backup-scheduler.state
/config/shared/.backup-scheduler.lock/
/.tmp/
*.patch
*.bak
*.tmp
*.temp

# local runtime databases
**/panel_runtime.db
**/settings.db
*.db
*.db-shm
*.db-wal

# local patch helpers
/apply-*.ps1
/fix-*.ps1
/repair-*.ps1
/finalize-*.ps1
/resume-*.ps1
