resolver 127.0.0.11 valid=5s ipv6=off;

upstream panel_web {
    zone panel_web_edge_tls 64k;
    server panel-web:8080 resolve;
    keepalive 32;
}

server {
    listen 80;
    server_name ${IGUANA_PUBLIC_HOST};

    location = /nginx-health {
        access_log off;
        return 200 "ok\n";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name ${IGUANA_PUBLIC_HOST};

    ssl_certificate /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_session_timeout 1d;
    ssl_session_cache shared:iguana_tls_cache:10m;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    client_max_body_size 25m;

    location = /actuator/prometheus {
        return 403;
    }

    location ^~ /internal/api/bot/ {
        return 404;
    }

    location ^~ /internal/observability/ {
        return 404;
    }

    location ^~ /webhooks/vk/ {
        resolver 127.0.0.11 valid=30s ipv6=off;
        set $vk_upstream http://bot-vk:8080;
        rewrite ^/webhooks/vk/(.*)$ /callbacks/vk/$1 break;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 443;
        proxy_pass $vk_upstream;
    }

    location / {
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 443;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_next_upstream error timeout http_502 http_503 http_504;
        proxy_next_upstream_tries 3;
        proxy_pass http://panel_web;
    }
}
