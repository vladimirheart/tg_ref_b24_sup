<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Directional logging v28 -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!--
      Full log remains canonical. Directional logs are additional views over the
      same events, not replacements. APP_PANEL_LOG_PATH continues to override
      the full log path; APP_PANEL_LOG_DIR owns the directional files.
    -->
    <springProperty scope="context"
                    name="PANEL_LOG_FILE"
                    source="logging.file.name"
                    defaultValue="../logs/spring-panel.log"/>
    <springProperty scope="context"
                    name="ROOT_LOG_LEVEL"
                    source="logging.level.root"
                    defaultValue="INFO"/>
    <property name="PANEL_LOG_DIR" value="${APP_PANEL_LOG_DIR:-../logs}"/>
    <property name="PANEL_FILE_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{56} - %msg%n%ex"/>
    <property name="PANEL_CONSOLE_PATTERN"
              value="%d{HH:mm:ss.SSS} %-5level %logger{40} - %msg%n%ex"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${PANEL_CONSOLE_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="FULL" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${PANEL_LOG_FILE}</file>
        <encoder>
            <pattern>${PANEL_FILE_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${PANEL_LOG_DIR}/archive/spring-panel.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>25MB</maxFileSize>
            <maxHistory>21</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <appender name="STARTUP" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${PANEL_LOG_DIR}/startup.log</file>
        <encoder>
            <pattern>${PANEL_FILE_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${PANEL_LOG_DIR}/archive/startup.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>250MB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <appender name="INCIDENTS" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${PANEL_LOG_DIR}/incidents.log</file>
        <encoder>
            <pattern>${PANEL_FILE_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${PANEL_LOG_DIR}/archive/incidents.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>15MB</maxFileSize>
            <maxHistory>21</maxHistory>
            <totalSizeCap>400MB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <appender name="INTEGRATION" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${PANEL_LOG_DIR}/integration.log</file>
        <encoder>
            <pattern>${PANEL_FILE_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${PANEL_LOG_DIR}/archive/integration.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>20MB</maxFileSize>
            <maxHistory>21</maxHistory>
            <totalSizeCap>600MB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <appender name="BOTS" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${PANEL_LOG_DIR}/bots.log</file>
        <encoder>
            <pattern>${PANEL_FILE_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${PANEL_LOG_DIR}/archive/bots.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>15MB</maxFileSize>
            <maxHistory>21</maxHistory>
            <totalSizeCap>400MB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <appender name="ERRORS" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${PANEL_LOG_DIR}/errors.log</file>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>WARN</level>
        </filter>
        <encoder>
            <pattern>${PANEL_FILE_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${PANEL_LOG_DIR}/archive/errors.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>20MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>750MB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- Startup / readiness / schema / container lifecycle. -->
    <logger name="com.example.panel.PanelApplication" additivity="true">
        <appender-ref ref="STARTUP"/>
    </logger>
    <logger name="com.example.panel.config" additivity="true">
        <appender-ref ref="STARTUP"/>
    </logger>
    <logger name="org.springframework.boot" additivity="true">
        <appender-ref ref="STARTUP"/>
    </logger>
    <logger name="org.flywaydb" additivity="true">
        <appender-ref ref="STARTUP"/>
    </logger>
    <logger name="com.zaxxer.hikari" additivity="true">
        <appender-ref ref="STARTUP"/>
    </logger>
    <logger name="org.hibernate" additivity="true">
        <appender-ref ref="STARTUP"/>
    </logger>
    <logger name="org.apache.catalina" additivity="true">
        <appender-ref ref="STARTUP"/>
    </logger>
    <logger name="org.apache.coyote" additivity="true">
        <appender-ref ref="STARTUP"/>
    </logger>
    <logger name="org.apache.tomcat" additivity="true">
        <appender-ref ref="STARTUP"/>
    </logger>

    <!-- Incident lifecycle and delivery. -->
    <logger name="com.example.panel.controller.IncidentApiController" additivity="true">
        <appender-ref ref="INCIDENTS"/>
    </logger>
    <logger name="com.example.panel.service.IncidentService" additivity="true">
        <appender-ref ref="INCIDENTS"/>
    </logger>
    <logger name="com.example.panel.service.IncidentRouteDeliveryService" additivity="true">
        <appender-ref ref="INCIDENTS"/>
    </logger>
    <logger name="com.example.panel.service.IncidentRouteDeliveryOutboxService" additivity="true">
        <appender-ref ref="INCIDENTS"/>
    </logger>

    <!-- Integration transport / recovery / queue operations. -->
    <logger name="com.example.panel.service.integration" additivity="true">
        <appender-ref ref="INTEGRATION"/>
    </logger>
    <logger name="com.example.panel.controller.AnalyticsIntegrationTransportController" additivity="true">
        <appender-ref ref="INTEGRATION"/>
    </logger>
    <logger name="com.example.panel.service.ChannelTransportService" additivity="true">
        <appender-ref ref="INTEGRATION"/>
    </logger>

    <!-- Bot process lifecycle owned by the panel. -->
    <logger name="com.example.panel.service.BotProcessService" additivity="true">
        <appender-ref ref="BOTS"/>
    </logger>

    <!-- Every accepted event still flows through root into FULL. WARN+ also goes to ERRORS. -->
    <root level="${ROOT_LOG_LEVEL}">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FULL"/>
        <appender-ref ref="ERRORS"/>
    </root>
</configuration>
