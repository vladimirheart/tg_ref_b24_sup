# Iguana first-run template
#
# Default first-run bootstrap is PostgreSQL/RabbitMQ-oriented.
# Fresh `scripts/bootstrap-first-run.*` bootstrap generates random secret values automatically.
# This template keeps manual placeholders and must not be treated as a production-ready secret source.

# Bootstrap helper
IGUANA_BOOTSTRAP_DB_MODE=postgresql
APP_POSTGRES_PORT=5432
APP_RABBITMQ_AMQP_PORT=5672
APP_RABBITMQ_HTTP_PORT=15672

# Database mode
APP_DB_MODE=postgresql
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/iguana
SPRING_DATASOURCE_USERNAME=iguana
SPRING_DATASOURCE_PASSWORD=iguana
APP_COORDINATION_MODE=direct
APP_COORDINATION_REQUIRED_FOR_POSTGRESQL=false
APP_STORAGE_OBJECT_REQUIRED_FOR_POSTGRESQL=false
APP_INTEGRATION_TRANSPORT_MODE=rabbitmq
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=iguana
SPRING_RABBITMQ_PASSWORD=iguana

# Full dockerized production-like contour
# Compose file: docker-compose.production-contour.yml
IGUANA_POSTGRES_DB=iguana
IGUANA_POSTGRES_USER=iguana
IGUANA_POSTGRES_PASSWORD=iguana
APP_POSTGRES_BIND_HOST=127.0.0.1
IGUANA_RABBITMQ_USER=iguana
IGUANA_RABBITMQ_PASSWORD=iguana
APP_RABBITMQ_AMQP_BIND_HOST=127.0.0.1
APP_RABBITMQ_HTTP_BIND_HOST=127.0.0.1
APP_REDIS_PORT=6379
APP_REDIS_BIND_HOST=127.0.0.1
IGUANA_REDIS_PASSWORD=iguana-redis
APP_COORDINATION_MODE=redis
APP_COORDINATION_REQUIRED_FOR_POSTGRESQL=true
APP_STORAGE_OBJECT_MODE=s3
APP_STORAGE_OBJECT_REQUIRED_FOR_POSTGRESQL=true
APP_STORAGE_OBJECT_BUCKET=iguana
APP_STORAGE_OBJECT_REGION=us-east-1
APP_STORAGE_OBJECT_KEY_PREFIX=iguana
APP_STORAGE_OBJECT_LEGACY_LOCAL_FALLBACK_ENABLED=true
APP_STORAGE_OBJECT_BIND_HOST=127.0.0.1
APP_STORAGE_OBJECT_CONSOLE_BIND_HOST=127.0.0.1
APP_STORAGE_OBJECT_ACCESS_KEY=iguana-minio
APP_STORAGE_OBJECT_SECRET_KEY=iguana-minio-secret

# Stable local loopback ingress. panel-web replicas themselves do not publish host ports.
APP_PANEL_BIND_HOST=127.0.0.1
APP_HTTP_PORT=8080

# Scale controls used by scripts/docker-production-up.*
IGUANA_PANEL_WEB_REPLICAS=1
IGUANA_OPS_WORKER_REPLICAS=1
IGUANA_PANEL_IMAGE=iguana-panel:local

APP_INTERNAL_BOT_API_TOKEN=change-me
APP_INTERNAL_BOT_API_SIGNATURE_SECRET=
APP_INTERNAL_BOT_API_REQUIRE_REQUEST_SIGNATURE=true
APP_SECURITY_REMEMBER_ME_KEY=change-me
APP_SECURITY_BOOTSTRAP_ADMIN_USERNAME=
APP_SECURITY_BOOTSTRAP_ADMIN_PASSWORD=
APP_BOT_AUTO_START_ENABLED=false

# Required shared AES seed for explicit db-migrate / panel-web / ops-worker roles.
# All replicas must use the same value. Production preflight rejects change-me.
MONITORING_CREDENTIALS_MASTER_KEY=change-me

VK_BOT_BIND_HOST=127.0.0.1
MAX_BOT_BIND_HOST=127.0.0.1

# Optional reverse proxy / public edge contour
IGUANA_PUBLIC_HOST=localhost
IGUANA_EDGE_HTTP_BIND_HOST=0.0.0.0
IGUANA_EDGE_HTTP_PORT=80
IGUANA_EDGE_HTTPS_BIND_HOST=0.0.0.0
IGUANA_EDGE_HTTPS_PORT=443
IGUANA_EDGE_TLS_ENABLED=false
IGUANA_EDGE_CERTS_DIR=./deploy/nginx/certs

# Optional production observability contour
# Enabled with scripts/docker-production-up.* -Observability / --observability.
IGUANA_GRAFANA_ADMIN_USER=admin
IGUANA_GRAFANA_ADMIN_PASSWORD=change-me
IGUANA_GRAFANA_BIND_HOST=127.0.0.1
IGUANA_GRAFANA_PORT=3000
IGUANA_PROMETHEUS_BIND_HOST=127.0.0.1
IGUANA_PROMETHEUS_PORT=9090
IGUANA_PROMETHEUS_RETENTION=30d
IGUANA_ALERTMANAGER_BIND_HOST=127.0.0.1
IGUANA_ALERTMANAGER_PORT=9093
IGUANA_LOKI_BIND_HOST=127.0.0.1
IGUANA_LOKI_PORT=3100
IGUANA_ALLOY_BIND_HOST=127.0.0.1
IGUANA_ALLOY_PORT=12345
# Production backup/recovery contour. Must point to a mounted external failure domain.
# Enabled on the running contour with -Backup / --backup; jobs are invoked by docker-production-backup.*.
IGUANA_BACKUP_DESTINATION_DIR=
IGUANA_BACKUP_EXTERNAL_FAILURE_DOMAIN=false
IGUANA_BACKUP_ARCHIVE_FORMAT=tar.gz
IGUANA_BACKUP_MANUAL_MODE=critical
IGUANA_BACKUP_CUSTOM_COMPONENTS=postgres,minio,shared-config
IGUANA_BACKUP_RESTORE_COMPONENTS=postgres,minio,shared-config
IGUANA_BACKUP_CRITICAL_ENABLED=false
IGUANA_BACKUP_CRITICAL_FREQUENCY=daily
IGUANA_BACKUP_CRITICAL_TIME=02:00
IGUANA_BACKUP_CRITICAL_WEEKDAY=MON
IGUANA_BACKUP_FULL_ENABLED=false
IGUANA_BACKUP_FULL_FREQUENCY=weekly
IGUANA_BACKUP_FULL_TIME=03:00
IGUANA_BACKUP_FULL_WEEKDAY=SUN
IGUANA_BACKUP_RETENTION_DAYS=30
IGUANA_MINIO_BACKUP_RETENTION_DAYS=14
IGUANA_MINIO_BACKUP_TOOLS_IMAGE=iguana-minio-backup-tools:local

# Optional bind-mount overrides for containerized contour
IGUANA_SHARED_CONFIG_DIR=./config/shared
IGUANA_ATTACHMENTS_DIR=./attachments
IGUANA_LOGS_DIR=./logs
IGUANA_BOT_DATABASES_DIR=./bot_databases
# Read-only staging directory used exclusively by the one-shot db-migrate role.
# Populate it with scripts/stage-legacy-sqlite-import.* before a legacy import.
IGUANA_LEGACY_SQLITE_STAGING_DIR=./.tmp/legacy-sqlite-import

# One-time migration compatibility
IGUANA_LEGACY_SQLITE_AUTO_IMPORT=false

# Local storage
APP_STORAGE_ATTACHMENTS=../attachments
APP_STORAGE_KNOWLEDGE_BASE=../attachments/knowledge_base
APP_STORAGE_AVATARS=../attachments/avatars
APP_STORAGE_WEBFORMS=../attachments/forms
APP_BOT_DATABASE_DIR=../bot_databases

# Logs
APP_PANEL_LOG_DIR=../logs
APP_BOT_LOG_DIR=../logs

# Iguana backend deployment role.
# Local/dev non-Docker compatibility default remains all.
# Production compose overrides this per service: db-migrate / panel-web / ops-worker / bot-runner.
APP_RUNTIME_ROLE=all
# APP_INSTANCE_ID=

# Distributed UI/SSE fanout. Explicit web/worker roles require redis.
APP_UI_EVENT_FANOUT_MODE=auto
APP_UI_EVENT_FANOUT_CHANNEL=iguana:ui-events:v1

# Used only by one-shot db-migrate service in production compose.
APP_RUNTIME_EXIT_AFTER_MIGRATION=false
