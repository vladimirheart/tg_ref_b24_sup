# Iguana first-run template
#
# By default the bootstrap scripts prefer local PostgreSQL when Docker is available.
# Without Docker they fall back to SQLite dev mode so the project still starts.

# Bootstrap helper
IGUANA_BOOTSTRAP_DB_MODE=auto
APP_POSTGRES_PORT=5432
APP_RABBITMQ_AMQP_PORT=5672
APP_RABBITMQ_HTTP_PORT=15672

# Database mode
APP_DB_MODE=postgresql
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/iguana
SPRING_DATASOURCE_USERNAME=iguana
SPRING_DATASOURCE_PASSWORD=iguana
APP_INTEGRATION_TRANSPORT_MODE=rabbitmq
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=iguana
SPRING_RABBITMQ_PASSWORD=iguana

# Local storage
APP_STORAGE_ATTACHMENTS=attachments
APP_STORAGE_KNOWLEDGE_BASE=attachments/knowledge_base
APP_STORAGE_AVATARS=attachments/avatars
APP_STORAGE_WEBFORMS=attachments/forms
APP_BOT_DATABASE_DIR=bot_databases

# Logs
APP_PANEL_LOG_DIR=logs
APP_BOT_LOG_DIR=logs
